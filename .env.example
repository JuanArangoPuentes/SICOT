# ═══════════════════════════════════════════════════════════════════════════
# SICOT — variables para docker-compose (raíz del proyecto)
# Copie a `.env` en esta misma carpeta antes de `docker compose up` si quiere
# sobrescribir los valores de desarrollo por defecto.
# ═══════════════════════════════════════════════════════════════════════════

# "dev" siembra los usuarios de prueba (contraseñas conocidas). En el
# servidor remoto de producción, cambie esto a "prod" (o cualquier valor
# distinto de "dev") para que esas cuentas NUNCA se creen ahí.
SPRING_PROFILES_ACTIVE=dev

DB_PASSWORD=replace_me
# Clave HMAC-SHA256 >= 32 bytes en Base64. Generar con: openssl rand -base64 48
JWT_SECRET=replace_me_with_base64_secret
# URL que el NAVEGADOR del usuario usará para llamar al backend (no el nombre
# del servicio interno de Docker).
VITE_API_URL=http://localhost:8080

# Correo real para entrega de credenciales al crear un usuario. Con Gmail:
# generar una "Contraseña de aplicación" en myaccount.google.com/apppasswords.
# Sin esto, el sistema falla honestamente al enviar en vez de fingir éxito.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace_me@gmail.com
MAIL_PASSWORD=replace_me_app_password
MAIL_FROM=replace_me@gmail.com

# IA local (Ollama) — debe correr en el mismo host que Docker; el backend le
# habla vía host.docker.internal (ya resuelto en docker-compose.yml). Cambie
# el modelo aquí según la máquina (chico si es un servidor sin GPU, grande si
# tiene GPU potente) — ver backend/README.md § "Elegir el modelo".
OLLAMA_MODEL=qwen2.5-coder:7b
