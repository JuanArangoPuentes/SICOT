# ═══════════════════════════════════════════════════════════════════════════
# SICOT — variables para docker-compose (raíz del proyecto)
# Copie a `.env` en esta misma carpeta antes de `docker compose up` si quiere
# sobrescribir los valores de desarrollo por defecto.
# ═══════════════════════════════════════════════════════════════════════════

# "dev" siembra los usuarios de prueba (contraseñas conocidas). En el
# servidor remoto de producción, cambie esto a "prod" — activa
# backend/src/main/resources/application-prod.properties (Swagger deja de
# ser público, log menos verboso) y evita que esas cuentas de prueba se
# creen ahí.
SPRING_PROFILES_ACTIVE=dev

DB_PASSWORD=replace_me
# Clave HMAC-SHA256 >= 32 bytes en Base64. Generar con: openssl rand -base64 48
JWT_SECRET=replace_me_with_base64_secret

# URL que el NAVEGADOR del usuario usará para llamar al backend — NO el
# nombre del servicio interno de Docker. Se hornea en el frontend EN TIEMPO
# DE BUILD (docker-compose.yml pasa esto como build-arg), así que:
#   - Si todo corre en una sola máquina (localhost): dejar el valor por
#     defecto de abajo.
#   - Si otras personas van a abrir el frontend desde otra máquina de la
#     LAN o de Internet (despliegue real): cambiar esto a la IP o dominio
#     real del servidor, p. ej. http://192.168.1.50:8080 o
#     https://sicot.miempresa.com — y luego reconstruir:
#     `docker compose build frontend` (un simple restart NO basta, porque
#     el valor ya quedó incrustado en los archivos JS compilados).
VITE_API_URL=http://localhost:8080

# Orígenes desde los que el navegador puede llamar al backend (CORS). Debe
# incluir la MISMA URL desde la que se sirve el frontend en el navegador del
# usuario — si VITE_API_URL cambia de "localhost" a una IP/dominio real,
# esto también debe cambiar (backend/application.properties trae un default
# de solo-localhost si no se define).
CORS_ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443

# Correo real para entrega de credenciales al crear un usuario. Con Gmail:
# generar una "Contraseña de aplicación" en myaccount.google.com/apppasswords.
# Sin esto, el sistema falla honestamente al enviar en vez de fingir éxito.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace_me@gmail.com
MAIL_PASSWORD=replace_me_app_password
MAIL_FROM=replace_me@gmail.com

# IA local (Ollama) — debe correr en el mismo host que Docker; el backend le
# habla vía host.docker.internal (ya resuelto en docker-compose.yml). Cambie
# el modelo aquí según la máquina (chico si es un servidor sin GPU, grande si
# tiene GPU potente) — ver backend/README.md § "Elegir el modelo".
OLLAMA_MODEL=qwen2.5-coder:7b
