# ═══════════════════════════════════════════════════════════════════════════
# SICOT Backend — variables de entorno requeridas
# Copie este archivo a `.env` (o exporte las variables) antes de ejecutar.
# ═══════════════════════════════════════════════════════════════════════════

# ── Base de datos PostgreSQL ────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/sicot
DB_USERNAME=sicot
DB_PASSWORD=replace_me

# ── Seguridad ───────────────────────────────────────────────────────────────
# Clave HMAC-SHA256 de mínimo 32 bytes codificada en Base64.
# Generar con:  openssl rand -base64 48
JWT_SECRET=replace_me_with_base64_secret
# Duración del token en milisegundos (8 horas).
JWT_EXPIRATION_MS=28800000

# ── CORS ────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Correo (entrega real de credenciales al crear un usuario) ─────────────────
# Sin esto configurado, el sistema falla honestamente al intentar enviar (no
# finge éxito). Con Gmail: generar una "Contraseña de aplicación" en la cuenta
# (no la contraseña normal) — myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace_me@gmail.com
MAIL_PASSWORD=replace_me_app_password
MAIL_FROM=replace_me@gmail.com

# ── SMS (entrega real de credenciales al crear un usuario) ─────────────────
# Cuenta de Twilio (console.twilio.com): Account SID y Auth Token están en el
# dashboard principal; TWILIO_FROM_NUMBER es un número de Twilio habilitado
# para SMS. Sin esto configurado, el sistema falla honestamente al enviar.
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=+10000000000

# ── Servidor ────────────────────────────────────────────────────────────────
PORT=8080
