# ═══════════════════════════════════════════════════════════════════════════
# ESTE ARCHIVO ES UNA PLANTILLA, NO UNA CONFIGURACIÓN LISTA
#
# La imagen `nginxinc/nginx-unprivileged` procesa al arrancar todo lo que
# encuentre en /etc/nginx/templates/*.template: sustituye las variables de
# entorno con `envsubst` y escribe el resultado en /etc/nginx/conf.d/. Por eso
# frontend/Dockerfile copia este archivo a
# /etc/nginx/templates/default.conf.template y NO a conf.d directamente.
#
# Se hizo así por UNA sola línea: los orígenes extra de `connect-src` (ver el
# bloque de la CSP más abajo), que hacen falta en desarrollo y sobran en
# producción. Todo lo demás es idéntico en los dos entornos. La alternativa
# —mantener dos archivos casi iguales— envejece mal: se corrige algo en uno, se
# olvida el otro, y la única diferencia real queda enterrada entre cien líneas
# repetidas.
#
# CUIDADO al editar: `envsubst` reemplazaría también las variables PROPIAS de
# nginx ($uri, $csp, $args…) si coincidieran con nombres del entorno. Por eso
# frontend/Dockerfile fija NGINX_ENVSUBST_FILTER="^CSP_": solo se sustituyen
# las variables cuyo nombre empieza por CSP_. Si algún día se añade otra
# variable a esta plantilla, tiene que respetar ese prefijo o hay que ampliar
# el filtro.
#
# (Esa lista de ejemplos evita a propósito la variable del Host de la petición:
# el Semgrep del CI la marca en CUALQUIER archivo de nginx, comentarios
# incluidos, y bloquea el PR. No es un falso positivo que valga la pena silenciar
# con un `nosemgrep` — basta con no usarla de ejemplo.)
# ═══════════════════════════════════════════════════════════════════════════

# Oculta la versión exacta de nginx en la cabecera Server y en las páginas de
# error. No es una defensa por sí sola, pero publicar "nginx/1.27.5" le ahorra
# a un escáner el trabajo de averiguar contra qué versión probar.
server_tokens off;

server {
    listen 8443;
    # Explícito (no delegado al entrypoint de la imagen): con la imagen
    # nginx-unprivileged este archivo queda con dueño root y el usuario no-root
    # del contenedor no puede reescribirlo para agregar esto solo, así que se
    # declara acá directamente — sin esto, "localhost" adentro del contenedor
    # puede resolver primero a ::1 y el healthcheck falla con "connection refused".
    listen [::]:8443;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # ── Cabeceras de seguridad ───────────────────────────────────────────────
    #
    # Este origen es el que ejecuta el JavaScript de SICOT y el que guarda el
    # JWT de la sesión en localStorage, y hasta ahora no enviaba ni una sola
    # cabecera de seguridad. El backend sí las trae (Spring Security las pone
    # por defecto), pero eso no protege a la aplicación: quien las necesita es
    # la página.
    #
    # Van dentro de un `include` reutilizable porque `add_header` NO se hereda
    # cuando un bloque `location` declara sus propias cabeceras: el bloque de
    # assets de más abajo añade Cache-Control, y sin repetir estas aquí, todos
    # los .js y .css quedarían servidos sin ninguna protección. Es el error
    # clásico al endurecer nginx y no da ningún síntoma visible.
    #
    # Sobre la CSP: `script-src 'self'` basta porque Vite compila a archivos
    # externos, sin scripts en línea. `style-src` admite 'unsafe-inline'
    # porque Tailwind y React inyectan estilos en línea en tiempo de
    # ejecución; restringirlo rompería la interfaz.
    # `style-src` ya NO admite dominios externos: las tipografías se sirven desde
    # este mismo origen (ver frontend/src/fuentes.css), así que no hay ninguna
    # excepción de terceros que mantener
    # Space Grotesk e IBM Plex. La primera versión de esta CSP no los incluía y
    # BLOQUEABA las tipografías: la interfaz caía a las fuentes del sistema, con
    # un error en consola y sin ningún síntoma en el servidor. Es la clase de
    # regresión que una CSP introduce muy fácil, porque solo se ve en el
    # navegador del usuario.
    #
    # Nota para el futuro: alojar las tipografías en el propio servidor sería
    # mejor que depender de un tercero — funcionaría sin conexión (que es
    # justo lo que necesita la instalación de escritorio de ADR-001), evitaría
    # que la IP de cada funcionario llegue a Google, y quitaría una petición
    # externa que bloquea el pintado. Queda anotado en ADR-004.
    #
    # ── Por qué `connect-src` depende del entorno ────────────────────────────
    #
    # En DESARROLLO (docker-compose.yml) la SPA se sirve en :8443 y llama al
    # backend en :8080. Son orígenes distintos, así que 'self' no alcanza: hay
    # que nombrar el backend explícitamente o el navegador bloquea todas las
    # peticiones de la aplicación.
    #
    # En PRODUCCIÓN (docker-compose.prod.yml) sobran: el frontend se construye
    # con VITE_API_URL="" y el proxy Caddy sirve la SPA y enruta /api al mismo
    # dominio (ADR-009), así que 'self' ya cubre todas las llamadas. Dejar ahí
    # los orígenes de localhost no habilitaría nada útil y sí relajaría la
    # política: `connect-src http://localhost:8080` NO autoriza conexiones al
    # localhost del SERVIDOR, sino al del NAVEGADOR de quien abre la página. Un
    # script inyectado podría hablarle a lo que esa persona tenga escuchando en
    # su propio puerto 8080. Riesgo bajo, pero gratis de eliminar.
    #
    # El valor por defecto (vacío, fijado en frontend/Dockerfile) es el
    # restrictivo a propósito: si un despliegue nuevo olvida definir la
    # variable, la CSP queda de más estricta, no de más laxa. Le toca a
    # desarrollo pedir la excepción en voz alta, no a producción acordarse de
    # quitarla.
    #
    # Con la variable vacía el resultado es "connect-src 'self' ;". Ese espacio
    # de más es inofensivo —el navegador separa la directiva por espacios y
    # descarta los huecos vacíos— y está así a propósito: evitarlo obligaría a
    # que el valor de la variable empezara por un espacio, un detalle invisible
    # que cualquiera limpiaría sin darse cuenta, dejando 'self'http://… pegado
    # y la directiva rota.
    #
    # img-src admite blob: para la vista previa de la foto de evidencia antes de
    # cargarla (EvidenciaFotografica): el navegador la muestra desde una URL de
    # objeto creada a partir del archivo que el propio usuario eligió. Sin blob:
    # la vista previa salía rota, en la web y en la app. Una URL blob: solo la
    # puede crear un script que ya corre en esta página, así que no abre ninguna
    # puerta que 'self' no hubiera abierto antes. La CSP de la app de escritorio
    # y de Android (tauri.conf.json) lleva el mismo cambio.
    set $csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ${CSP_CONNECT_SRC_EXTRA}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'";

    # ── La API, por el mismo origen que la aplicación ───────────────────────
    #
    # Lo mismo que hace Caddy en producción (ver Caddyfile): /api, /actuator y
    # la documentación van al backend; todo lo demás, a la SPA. Aquí se repite
    # para que en desarrollo la aplicación web viva en UN solo origen, igual
    # que en el Centro.
    #
    # POR QUÉ, si antes funcionaba cruzando orígenes. Porque no funcionaba
    # fuera de este equipo. La dirección de la API la hornea Vite al construir
    # (`VITE_API_URL`), así que una imagen construida con `localhost` le dice al
    # navegador del OTRO computador que la API está en su propia máquina, donde
    # no hay nada; y una construida con la IP de este deja de servir en cuanto
    # la IP cambia — pasó el 03-11-2026 a media prueba, al cambiar de red. Con
    # el proxy no hay ninguna dirección que acertar: quien abra
    # `http://<lo-que-sea>:8443` llega a la API por ese mismo sitio.
    #
    # De paso desaparecen dos cosas que había que mantener cuadradas entre sí:
    # el `connect-src` de la CSP de aquí abajo y el `VITE_API_URL` del build. Y
    # el otro equipo necesita UN puerto abierto en el cortafuegos, no dos. La
    # lista de orígenes de CORS del backend deja de importar para el navegador
    # SOLO porque aquí abajo se reenvía el Host tal cual (ver `Host`).
    #
    # El 8080 se sigue publicando en docker-compose.yml y sirve igual: la
    # aplicación de escritorio y el APK lo usan tal cual, y Swagger vive ahí.
    # Esto no lo sustituye, le añade un camino que no depende de la IP.

    # El nombre `backend` se resuelve en cada petición con el DNS de Docker, y
    # no una sola vez al cargar la configuración. Con `proxy_pass
    # http://backend:8080` literal, nginx lo resolvía al arrancar: si el backend
    # todavía no existía —al reiniciar el PC, Docker levanta los contenedores
    # sin el orden de `depends_on`— el frontend no arrancaba («host not found
    # in upstream»), y si el backend se recreaba con otra IP, nginx seguía
    # llamando a la vieja y todo /api daba 502 mientras el 8080 respondía bien.
    # Con una variable en `proxy_pass`, nginx pregunta al resolvedor y respeta
    # su caducidad. Sin URI en la variable se reenvía la ruta original entera.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $sicot_backend http://backend:8080;

    proxy_http_version 1.1;

    # El Host con el que llegó la petición, puerto incluido —la variable
    # http_host de nginx y no host, que lo pierde—. Sin esto nginx manda
    # `Host: backend:8080`, y Spring decide si una petición es «de otro origen»
    # comparando su cabecera Origin con el Host: el navegador del OTRO computador manda
    # `Origin: http://<IP>:8443` en cada POST, Spring lo veía distinto de
    # `backend:8080`, lo trataba como CORS y, como esa IP no está en
    # CORS_ALLOWED_ORIGINS, respondía 403 «Invalid CORS request». La página
    # cargaba y no dejaba entrar. En este mismo equipo no se veía, porque
    # `localhost:8443` sí está en la lista (comprobado con curl el 05-11-2026:
    # 403 con el Origin de la IP, 401 con el de localhost).
    #
    # Es lo mismo que hace Caddy en producción, que reenvía el Host original por
    # omisión. El upstream es fijo (`$sicot_backend`), así que el Host del
    # cliente no decide a dónde se conecta nginx: solo llega al backend.
    proxy_set_header Host $http_host; # nosemgrep: generic.nginx.security.request-host-used.request-host-used
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # `^~` y no un prefijo a secas: nginx evalúa los bloques con expresión
    # regular ANTES que los de prefijo, y más abajo hay uno que captura todo lo
    # que termine en .js, .css, .svg… Sin esto, el día que una ruta de la API
    # acabe en una de esas extensiones se serviría desde el disco de la SPA y
    # devolvería 404, con el proxy intacto y sin nada en los logs del backend.
    # `^~` dice: si este prefijo es el que mejor encaja, no mires las regex.
    location ^~ /api/ {
        proxy_pass $sicot_backend;

        # Sin buffering: la respuesta del Copiloto llega token a token
        # (`application/x-ndjson`, ver CopilotoController y ADR-014). Guardada
        # en un búfer, llegaría entera al final y parecería que el streaming
        # «no funciona» — que es exactamente el síntoma que costó encontrar al
        # migrar a Spring 7. El backend ya manda `X-Accel-Buffering: no`, que
        # nginx respeta; esto lo deja dicho también aquí, para todo /api.
        proxy_buffering off;
        proxy_request_buffering off;

        # Una pregunta abierta al Copiloto sobre CPU tarda minutos
        # (`OLLAMA_TIMEOUT_SECONDS`, 900 s por omisión). Con el minuto que trae
        # nginx por defecto, el proxy cortaría la respuesta antes que el modelo.
        proxy_read_timeout 960s;
        proxy_send_timeout 960s;

        # Los documentos pesan hasta 20 MB
        # (`spring.servlet.multipart.max-file-size`). El 1 MB por defecto de
        # nginx rechazaría la carga con un 413 antes de que el backend la viera.
        client_max_body_size 25m;
    }

    location ^~ /actuator/ {
        proxy_pass $sicot_backend;
    }

    # La documentación de la API, para alcanzarla también por este puerto.
    location ^~ /swagger-ui/ {
        proxy_pass $sicot_backend;
    }

    location ^~ /v3/api-docs {
        proxy_pass $sicot_backend;
    }

    location = /swagger-ui.html {
        proxy_pass $sicot_backend;
    }

    location / {
        # SICOT no usa router de navegador (la pantalla se controla por estado en
        # App.tsx), pero esto evita 404 si alguien navega directo a una ruta.
        try_files $uri $uri/ /index.html;

        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        # Ninguna de estas capacidades la usa SICOT: se apagan de forma
        # explícita para que un script inyectado tampoco pueda usarlas.
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        # HSTS solo tiene efecto sobre HTTPS; el navegador la ignora en claro.
        # Se deja puesta para que empiece a aplicar sola el día que haya
        # certificado, sin tener que acordarse de volver aquí.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    # Assets con hash de contenido en el nombre (Vite): un nombre nuevo en
    # cada build, así que cachearlos "para siempre" en el navegador es seguro
    # — nunca hay que invalidar, el propio nombre del archivo cambia.
    location ~* \.(?:js|css|svg|png|jpg|jpeg|gif|ico|woff2?|ttf)$ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;

        # Repetidas a propósito — ver la nota de arriba sobre la herencia de
        # add_header. Sin estas cuatro líneas, el JavaScript de la aplicación
        # se serviría sin ninguna cabecera de seguridad.
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
