{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SICOT",
  "version": "0.3.0",
  "identifier": "co.sena.ctma.sicot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8443",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SICOT — Supervisión de Contratos",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https:; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "SENA — Centro Tecnológico del Mobiliario",
    "copyright": "SENA — Centro Tecnológico del Mobiliario",
    "category": "Business",
    "shortDescription": "Supervisión de contratos del CTMA",
    "longDescription": "Aplicación de escritorio para que el supervisor del Centro Tecnológico del Mobiliario siga sus contratos según el procedimiento GCCON-P-010.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ]
      }
    }
  }
}
