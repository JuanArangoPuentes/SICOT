# ═══════════════════════════════════════════════════════════════════════════
# Terminación TLS de SICOT — ver docs/decisiones/ADR-009.
#
# Hasta este archivo, SICOT no servía HTTPS en ningún entorno: el JWT vivía en
# localStorage y viajaba por la red del centro en texto claro junto con las
# credenciales del formulario de acceso. La cabecera Strict-Transport-Security
# que ya emitía SecurityConfig no protegía nada, porque un navegador la ignora
# cuando llega por HTTP.
#
# Este proxy es el ÚNICO servicio que publica puertos al exterior. El frontend y
# el backend dejan de publicarlos y solo se alcanzan por la red interna de
# Docker, igual que ya hacía PostgreSQL en el perfil de producción.
#
# CÓMO ELIGE EL CERTIFICADO
# -------------------------
# Lo decide SICOT_TLS en el .env, no el nombre, y por defecto es `internal`:
#
#   - `internal`: Caddy emite el certificado con su propia autoridad local.
#     Cifra igual; el navegador pide confiar en él una vez y en los teléfonos
#     hay que instalar la raíz (INSTALACION.md). Es el caso más probable en la
#     red del Centro.
#   - Un correo (sistemas@ejemplo.gov.co): Caddy lo pide a Let's Encrypt por ACME,
#     con ese correo como contacto, y lo renueva solo. SOLO para un nombre
#     público con los puertos 80 y 443 alcanzables desde Internet.
#
# Antes no había esta línea y Caddy adivinaba por el nombre: certificado local
# solo para localhost, IPs, *.local, *.internal y similares; ACME para
# cualquier otro. Un nombre del DNS interno del Centro bajo un dominio real
# (sicot.<centro>.sena.edu.co) parece público: Caddy intentaba ACME, los
# desafíos fallaban porque desde Internet no se llega, y el sitio se quedaba
# SIN certificado —ni navegador, ni APK, ni escritorio completaban la
# conexión—, con solo reintentos en el log. Equivocarse hacia `internal` se ve
# al instante (el navegador avisa) y se corrige con una línea; equivocarse
# hacia ACME dejaba el sitio caído sin decir por qué.
#
# POR QUÉ EL BACKEND VA ANTES QUE EL FRONTEND
# -------------------------------------------
# Caddy evalúa los bloques por especificidad, no por orden de escritura, pero
# se listan así para que se lea igual que se resuelve: /api y /actuator y
# /swagger van al backend; todo lo demás, a la SPA.
#
# LA IP DEL CLIENTE, Y POR QUÉ NO HAY `trusted_proxies`
# -----------------------------------------------------
# En el perfil prod el backend lee X-Forwarded-For para saber qué equipo intenta
# entrar (server.forward-headers-strategy=native): sin eso, el límite de intentos
# fallidos por origen veía a todo el Centro como una sola IP, la de este proxy.
#
# Eso es seguro solo porque Caddy NO reenvía la cabecera que trae el cliente: la
# sustituye por la IP real de quien se conecta. Comprobado el 21-09-2026 con
# caddy 2.11.4: un cliente que envió «X-Forwarded-For: 198.51.100.7» llegó al
# backend con su propia dirección.
#
# Ese comportamiento cambia si se declara `trusted_proxies`. Si un día se pone
# otro balanceador delante, se declara SOLO la IP de ese balanceador. Declarar la
# red del Centro (10.0.0.0/8, 192.168.0.0/16…) permitiría a cualquier equipo
# elegir su propio origen escribiendo la cabecera, y escapar así del bloqueo.
#
# EL TÚNEL DE CLOUDFLARE ES ESE BALANCEADOR
# -----------------------------------------
# Con docker-compose.tunel.yml (INSTALACION.md, «Publicarlo por un túnel de
# Cloudflare») todas las peticiones llegan desde el contenedor del conector. Sin
# confiar en él, Caddy pondría la IP del conector en X-Forwarded-For y el
# backend vería a todo Internet como un solo equipo: veinte contraseñas erradas
# de cualquiera dejarían sin entrar a todos durante quince minutos.
#
# Por eso esa capa le da al conector una IP FIJA en una red que solo comparte
# con este proxy, y pasa esa IP en SICOT_TUNEL_IP. Solo esa dirección queda en
# `trusted_proxies`: Caddy conserva la cabecera que trae (la escribe el borde de
# Cloudflare, que añade al final la IP real de quien se conectó) y le agrega la
# del conector. La RemoteIpValve del backend recorre la cadena de derecha a
# izquierda, salta la del conector por ser interna y se queda con la del
# cliente. Lo que un cliente invente en la cabecera queda a la izquierda de esa
# IP real y no se lee.
#
# Sin la capa del túnel, SICOT_TUNEL_IP no existe y la lista queda vacía: Caddy
# no confía en nadie y todo funciona exactamente como se describe arriba.
# ═══════════════════════════════════════════════════════════════════════════

{
	servers {
		trusted_proxies static {$SICOT_TUNEL_IP}
	}
}

{$SICOT_DOMINIO:localhost} {
	# `internal` o el correo de la cuenta ACME: ver «CÓMO ELIGE EL CERTIFICADO».
	# Caddy rechaza al arrancar cualquier otro valor.
	tls {$SICOT_TLS:internal}

	# La API, la documentación y las métricas.
	#
	# Se enrutan por prefijo hacia el backend por su nombre de servicio en la
	# red interna de Docker. El puerto 8080 NO está publicado al host: solo
	# este proxy puede alcanzarlo.
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /actuator/* {
		reverse_proxy backend:8080
	}
	handle /swagger-ui/* {
		reverse_proxy backend:8080
	}
	# `*` sin barra delante: Swagger UI pide la definición en `/v3/api-docs`, a
	# secas, y `/v3/api-docs/*` no la cubre. Esa petición caía en la SPA y
	# Swagger decía «Failed to load API definition».
	handle /v3/api-docs* {
		reverse_proxy backend:8080
	}
	handle /swagger-ui.html {
		reverse_proxy backend:8080
	}

	# Todo lo demás es la aplicación de React servida por su nginx.
	#
	# Puerto 8443, NO 80. La imagen del frontend es `nginx-unprivileged`, que
	# corre como un usuario sin privilegios y por tanto no puede escuchar en un
	# puerto por debajo de 1024: `frontend/nginx.conf` declara `listen 8443` y
	# no hay nada sirviendo en el 80. Aquí decía 80, y con
	# `docker-compose.prod.yml` —donde el frontend ya no publica puertos al host
	# y sólo se alcanza por este proxy— eso dejaba TODA la aplicación
	# inalcanzable: las rutas de arriba (/api, /actuator, /swagger) seguían
	# funcionando, así que el backend respondía y sólo caía la SPA. Es decir, el
	# fallo se presentaba como "la página no carga" con la API sana.
	#
	# El número tiene que coincidir con `listen` en frontend/nginx.conf, con el
	# `EXPOSE` de frontend/Dockerfile y con el healthcheck de docker-compose.yml.
	handle {
		reverse_proxy frontend:8443
	}

	# Cabeceras que corresponden al borde y no a la aplicación.
	#
	# HSTS lo emite también SecurityConfig para las rutas de /api. Aquí se
	# emite para TODO el sitio —incluida la SPA— porque es el único punto por
	# el que entra el tráfico. Sin `preload` a propósito: enviar una lista de
	# precarga es una decisión con años de consecuencias y no le corresponde
	# tomarla a un archivo de configuración.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# El acceso queda en la salida estándar del contenedor, que es donde
	# `docker compose logs` lo encuentra.
	log {
		output stdout
		format console
	}
}
