# ═══════════════════════════════════════════════════════════════════════════
# SICOT Backend — variables de entorno requeridas
# Copie este archivo a `.env` (o exporte las variables) antes de ejecutar.
# ═══════════════════════════════════════════════════════════════════════════

# ── Perfil ──────────────────────────────────────────────────────────────────
# ⚠️  NO copie este valor tal cual a un servidor.
# "dev" siembra las cuentas de prueba del README (contraseñas publicadas) y
# deja Swagger público. En un servidor debe ser "prod" — o cualquier valor
# distinto de "dev" — para que esas cuentas NUNCA se creen ahí.
SPRING_PROFILES_ACTIVE=dev

# ── Base de datos PostgreSQL ────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/sicot
DB_USERNAME=sicot
DB_PASSWORD=replace_me

# ── Seguridad ───────────────────────────────────────────────────────────────
# Clave HMAC-SHA256 de mínimo 32 bytes codificada en Base64.
# Generar con:  openssl rand -base64 48
#
# En desarrollo puede dejarse sin definir: el perfil "dev" trae un secreto de
# conveniencia (application-dev.properties). Con cualquier otro perfil es
# obligatoria y el backend rehúsa arrancar si falta. Nunca reutilice el secreto
# de desarrollo en un servidor: está publicado en este repositorio.
JWT_SECRET=replace_me_with_base64_secret
# Duración del token en milisegundos (8 horas).
JWT_EXPIRATION_MS=28800000

# ── CORS ────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma. El frontend de este repo corre en
# el puerto 8443 (ver frontend/vite.config.ts), no en el 5173 por defecto de
# Vite — si se cambia el puerto del frontend, hay que reflejarlo aquí también.
CORS_ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443

# ── Correo (entrega real de credenciales al crear un usuario) ─────────────────
# Sin esto configurado, el sistema falla honestamente al intentar enviar (no
# finge éxito). Con Gmail: generar una "Contraseña de aplicación" en la cuenta
# (no la contraseña normal) — myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace_me@gmail.com
MAIL_PASSWORD=replace_me_app_password
MAIL_FROM=replace_me@gmail.com

# ── IA local (Ollama) ───────────────────────────────────────────────────────
# Ollama corre en la MISMA máquina que este backend (nunca en un servicio
# externo pago). Si el backend corre dentro de Docker, "localhost" apunta al
# contenedor, no al host — use host.docker.internal en ese caso (ver
# docker-compose.yml, que ya lo configura así por defecto).
OLLAMA_URL=http://localhost:11434
# Modelo a usar — cualquiera disponible en `ollama list`. En una máquina sin
# GPU (p. ej. el servidor remoto, solo para la extracción ocasional de
# Gestión) conviene uno chico (qwen2.5-coder:7b o menor). En una máquina con
# GPU potente (la del Supervisor, para el chat interactivo) conviene uno
# grande — ver README.md § "Elegir el modelo de Ollama".
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=900

# ── Servidor ────────────────────────────────────────────────────────────────
PORT=8080
