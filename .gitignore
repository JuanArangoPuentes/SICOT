.DS_Store
Thumbs.db
*.log
.env

# Red de seguridad genérica — cada subcarpeta (backend/, frontend/, mcp/) ya
# ignora lo suyo específicamente; esto solo cubre una carpeta nueva futura.
node_modules/
dist/
target/

# --- Herramientas de agentes de IA (locales, no se comparten) -----------------
# `.claude/launch.json` SÍ se versiona (configura el arranque del proyecto);
# todo lo demás bajo .claude/ es estado local de cada máquina.
.claude/*.lock
.claude/skills/
.claude/worktrees/
.claude/settings.local.json

# --- Entornos de desarrollo ---------------------------------------------------
.idea/
*.iml
*.swp
